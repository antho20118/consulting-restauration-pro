generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeArticle {
  MATIERE_PREMIERE
  SOUS_RECETTE
  PRODUIT_FINI
  EMBALLAGE
  CONSOMMABLE
  ENTRETIEN
  PETIT_MATERIEL
}

// Remplace l'ancien AccesApplication (un seul identifiant/code partagé pour toute l'équipe) : un
// compte nominatif par personne, avec un rôle qui borne ce qu'il peut écrire (voir la matrice de
// permissions dans server/app.ts). Sert aussi de traçabilité — qui a validé un contrôle HACCP ou
// enregistré une production (voir Production.creePar / ControleHACCPProduction.creePar) — jamais
// possible avec un code partagé. Rattaché à UNE SEULE société : un consultant qui intervient sur
// plusieurs sociétés a un compte par société, jamais un compte multi-société implicite.
enum RoleUtilisateur {
  PROPRIETAIRE // Accès total : paramètres société, gestion des comptes, tout le reste.
  CHEF // Recettes, HACCP, production, achats/fournisseurs ; pas les paramètres société ni les comptes.
  CUISINIER // Lecture des recettes + saisie des contrôles HACCP et de la production ; jamais les prix/achats.
  CONSULTANT // Lecture seule partout, aucune écriture.
}

model Utilisateur {
  id          Int             @id @default(autoincrement())
  identifiant String          @unique
  codeHache   String
  role        RoleUtilisateur
  actif       Boolean         @default(true)

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionsCreees    Production[]
  controlesCrees       ControleHACCPProduction[]
  documentsVentesCrees DocumentVentes[]
}

model Societe {
  id    Int     @id @default(autoincrement())
  nom   String
  siret String? @unique
  actif Boolean @default(true)

  // Coefficient multiplicateur (prix de vente conseillé = coût matière × coefficient — méthode de
  // tarification standard en restauration : coefficient 3 = food cost visé 33 %, 4 = 25 %, etc.).
  // Nullable et sans valeur par défaut délibérément : tant qu'aucun coefficient n'a été saisi
  // explicitement par l'utilisateur (voir Paramètres), l'agent Consulting ne simule aucun prix ni
  // food cost théorique — voir l'audit fonctionnel de l'agent Consulting, constat A3, et la
  // discussion qui a suivi sa correction (PR #65) : un coefficient par défaut imposerait une
  // hypothèse commerciale à un restaurant qui ne l'a pas choisie.
  coefficientMultiplicateur Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depots          Depot[]
  fournisseurs    Fournisseur[]
  articles        Article[]
  recettes        Recette[]
  menus           Menu[]
  productions     Production[]
  utilisateurs    Utilisateur[]
  documentsVentes DocumentVentes[]
}

model Depot {
  id          Int     @id @default(autoincrement())
  nom         String
  description String?

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks      Stock[]
  mouvements  MouvementStock[]
  commandes   CommandeFournisseur[]
  productions Production[]
}

model Categorie {
  id      Int     @id @default(autoincrement())
  nom     String  @unique
  couleur String?
  icone   String?

  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
}

// Catégories des recettes (Entrée, Plat, Dessert…), distinctes des catégories des ingrédients
// (Épicerie, Frais…) : les deux ne classent pas la même chose et ne doivent pas être mélangées.
model CategorieRecette {
  id    Int     @id @default(autoincrement())
  nom   String  @unique
  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recettes Recette[]
  menus    Menu[]
}

// Deuxième axe de classement des recettes, indépendant de CategorieRecette (Entrée/Plat/Dessert...)
// : le type d'ingrédient principal (Viande, Poisson, Pâtes, Riz...), pour filtrer les recettes par
// ce critère en plus de leur catégorie.
model SousCategorieRecette {
  id    Int     @id @default(autoincrement())
  nom   String  @unique
  actif Boolean @default(true)

  // Hiérarchie à un niveau : une sous-catégorie racine (ex. Viande) peut avoir des
  // sous-catégories enfants (ex. Bœuf, Veau, Porc, Agneau) pour préciser encore le
  // classement sans multiplier les axes de classement.
  parentId Int?
  parent   SousCategorieRecette?  @relation("SousCategorieHierarchie", fields: [parentId], references: [id])
  enfants  SousCategorieRecette[] @relation("SousCategorieHierarchie")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recettes Recette[]

  @@index([parentId])
}

model TVA {
  id   Int    @id @default(autoincrement())
  nom  String
  taux Float

  actif Boolean @default(true)

  articles Article[]
}

model Article {
  id Int @id @default(autoincrement())

  type TypeArticle

  nom        String
  reference  String?
  codeBarres String?

  categorieId Int
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  tvaId Int
  tva   TVA @relation(fields: [tvaId], references: [id])

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  rendement Float @default(100)

  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarifs TarifArticle[]
  stocks Stock[]

  nutrition           ValeurNutritionnelle?
  documents           Document[]
  allergenes          ArticleAllergene[]
  mouvements          MouvementStock[]
  lignesRecette       RecetteLigne[]
  aliasImport         AliasIngredientImport[]
  produitsFournisseur ProduitFournisseur[]
  lignesCommande      LigneCommandeFournisseur[]

  // Deux relations distinctes vers LigneDocumentFournisseur (voir ce modèle) : l'article que le
  // rapprochement a proposé n'est pas forcément celui que l'utilisateur a retenu (candidat
  // alternatif choisi, ou ligne rejetée) — jamais confondues, donc jamais une seule relation.
  lignesDocumentPropose LigneDocumentFournisseur[] @relation("ArticleProposeParLigne")
  lignesDocumentRetenu  LigneDocumentFournisseur[] @relation("ArticleRetenuParLigne")

  @@index([nom])
  @@index([reference])
  @@index([codeBarres])
}

// Mémorise, pour un texte d'ingrédient donné (ex. « persil plat », extrait d'un import texte/photo
// ou saisi lors d'une recherche manuelle), l'article déjà choisi la dernière fois — pour que
// l'import d'une future recette retrouve directement le bon article au lieu de re-proposer une
// correspondance approximative (voire aucune) à corriger à la main à chaque fois. Alimentée
// automatiquement à l'enregistrement d'une recette (voir POST/PUT /api/recettes), jamais éditée
// directement par l'utilisateur.
model AliasIngredientImport {
  id Int @id @default(autoincrement())

  // Texte d'ingrédient normalisé (minuscules, sans accents, espaces compactés) : clé de recherche,
  // volontairement indépendante de la casse/accentuation d'origine pour maximiser les réutilisations.
  texteNormalise String @unique

  articleId Int
  article   Article @relation(fields: [articleId], references: [id])

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@index([articleId])
}

model Fournisseur {
  id Int @id @default(autoincrement())

  // Identité métier stable, générée automatiquement (voir SocieteCompteur) — jamais saisie, jamais
  // dérivée du nom, jamais réutilisée après soft-delete. Nullable uniquement parce que les
  // fournisseurs déjà en base avant ce chantier n'en ont pas encore (attribution différée, humaine,
  // hors périmètre de cette migration — voir cadrage). Tout fournisseur créé à partir de ce chantier
  // en reçoit un immédiatement.
  codeFournisseur String?

  nom String

  telephone String?
  email     String?
  siteWeb   String?

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarifs    TarifArticle[]
  documents DocumentFournisseur[]
  produits  ProduitFournisseur[]
  commandes CommandeFournisseur[]

  @@unique([societeId, codeFournisseur])
}

// Compteur atomique par société, un par type de compteur (ex. "FOURNISSEUR") — incrémenté dans la
// même transaction que la création qu'il numérote (verrouillage de ligne implicite Postgres sur
// l'UPDATE, jamais un SELECT MAX(...)+1 ni un COUNT(*)+1, non sûrs sous créations concurrentes).
model SocieteCompteur {
  id Int @id @default(autoincrement())

  societeId    Int
  typeCompteur String
  valeur       Int    @default(0)

  @@unique([societeId, typeCompteur])
}

enum TypeImportTarifs {
  LISTING
  FACTURE
}

enum StatutDocumentFournisseur {
  EN_ATTENTE
  VALIDE
  IGNORE
}

// Document fournisseur original (listing ou facture, photographié ou déposé) — voir le cadrage
// Phase 0/1 : niveau A du pipeline (« ce que le document dit »). Le fichier lui-même ne vit jamais
// ici : `cle` est l'identifiant opaque du fichier sur le volume (voir
// server/utils/storageDocumentsFournisseur.ts), à combiner avec `fournisseurId` pour le retrouver
// — jamais un chemin, jamais le contenu binaire, jamais de base64.
model DocumentFournisseur {
  id Int @id @default(autoincrement())

  fournisseurId Int
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  type   TypeImportTarifs
  statut StatutDocumentFournisseur @default(EN_ATTENTE)

  // Référence opaque vers storageDocumentsFournisseur.ts (racine + "fournisseurs/<fournisseurId>/<cle>.<ext>")
  // — jamais un chemin construit ici, jamais réutilisée pour un autre fournisseur.
  cle                String  @unique
  typeMime           String
  tailleOctets       Int
  nomFichierOriginal String?

  // Renseignés uniquement pour une facture, extraits du document — jamais inventés si absents (même
  // règle de non-invention déjà suivie par l'extraction IA des recettes). Toujours null pour un
  // listing.
  numero       String?
  dateDocument DateTime?
  montantTotal Float?

  importeLe DateTime @default(now())

  lignes LigneDocumentFournisseur[]

  @@index([fournisseurId])
}

model TarifArticle {
  id Int @id @default(autoincrement())

  articleId               Int
  fournisseurId           Int
  uniteId                 Int
  conditionnementId       Int
  quantiteConditionnement Float

  unite           Unite           @relation(fields: [uniteId], references: [id])
  conditionnement Conditionnement @relation(fields: [conditionnementId], references: [id])
  prixHT          Float

  dateDebut DateTime  @default(now())
  dateFin   DateTime?

  actif Boolean @default(true)

  article     Article     @relation(fields: [articleId], references: [id])
  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id])

  // Identité stable du produit chez CE fournisseur (voir ProduitFournisseur) — nullable : un tarif
  // créé sans code produit fournisseur connu (chemin historique, ou tarif antérieur à ce chantier)
  // garde cette valeur à null pour toujours, jamais reconstruite après coup par supposition. Quand
  // renseigné, produitFournisseur.fournisseurId doit toujours être égal à fournisseurId ci-dessus —
  // invariant garanti par le code applicatif (jamais par le client), jamais par une contrainte SQL
  // croisée entre deux FK.
  produitFournisseurId Int?
  produitFournisseur   ProduitFournisseur? @relation(fields: [produitFournisseurId], references: [id])

  // Ligne de document (facture ou listing) ayant créé précisément CE tarif — voir
  // LigneDocumentFournisseur.tarifCreeId (FK unique, portée par l'autre modèle). Null pour un tarif
  // créé manuellement (formulaire article), par l'ancien import Excel sécurisé des recettes, ou
  // créé avant ce chantier : ces tarifs restent parfaitement valides sans source documentaire,
  // jamais une source inventée a posteriori (voir cadrage, règle de non-invention).
  ligneDocumentSource LigneDocumentFournisseur?

  @@index([articleId])
  @@index([fournisseurId])
  @@index([produitFournisseurId])
}

// Identité stable d'un produit chez UN fournisseur précis — jamais un prix (voir TarifArticle pour
// l'historique de prix, en relation 1-n avec ce modèle). Le code produit fournisseur n'est unique
// que par fournisseur (@@unique ci-dessous) : le même code chez deux fournisseurs différents désigne
// deux ProduitFournisseur distincts, jamais fusionnés (voir cadrage, chantier identité fournisseur +
// produit fournisseur + historique des tarifs).
model ProduitFournisseur {
  id Int @id @default(autoincrement())

  fournisseurId Int
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  codeProduitFournisseur String

  articleId Int
  article   Article @relation(fields: [articleId], references: [id])

  // Dernière désignation lue pour ce code chez ce fournisseur — jamais réécrite silencieusement si
  // une désignation très différente est ensuite lue pour le même code (voir la proposition
  // "alerte_code_produit_designation_differente", décision humaine requise).
  designationConnue String

  createdAt DateTime @default(now())

  tarifs TarifArticle[]

  @@unique([fournisseurId, codeProduitFournisseur])
  @@index([articleId])
}

enum NatureLigneFournisseur {
  ARTICLE
  FRAIS_LIVRAISON
  AVOIR
  NON_ALIMENTAIRE
  REMISE
}

enum MotifCorrespondance {
  REFERENCE_FOURNISSEUR
  CODE_ARTICLE
  ALIAS
  DESIGNATION_EXACTE
  DESIGNATION_APPROXIMATIVE
}

enum DecisionLigneFournisseur {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

// Une ligne d'un DocumentFournisseur, séparant strictement les trois niveaux du cadrage (jamais
// mélangés) :
//   A. ce que le document dit réellement (designationLue, prixLu, ...) ;
//   B. ce que le moteur de rapprochement (Phase 3, pas encore modifié ici) propose
//      (articleProposeId, confiance, candidatsAlternatifs) ;
//   C. ce que l'utilisateur a réellement validé et appliqué (decision, articleRetenuId, tarifCreeId).
// Le moteur de rapprochement lui-même n'est pas touché en Phase 2 : ces champs existent déjà pour
// qu'il les remplisse en Phase 3, sans nouvelle migration à ce moment-là.
model LigneDocumentFournisseur {
  id Int @id @default(autoincrement())

  documentId Int
  document   DocumentFournisseur @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // --- A. Données lues (jamais réinterprétées après coup) ---
  designationLue    String
  referenceLue      String?
  quantiteLue       Float?
  uniteLue          String?
  conditionnementLu String?
  prixLu            Float?

  // Nature détectée AVANT le rapprochement (voir cadrage §6) : une ligne de frais de
  // livraison/avoir/remise/non-alimentaire ne doit jamais entrer dans le pipeline de
  // création/modification de tarif, même si elle ressemble à un article par ailleurs.
  natureLigne NatureLigneFournisseur @default(ARTICLE)

  // --- B. Correspondance proposée (jamais une décision) ---
  articleProposeId     Int?
  articlePropose       Article?             @relation("ArticleProposeParLigne", fields: [articleProposeId], references: [id])
  confiance            Float?
  motifCorrespondance  MotifCorrespondance?
  // Candidats concurrents pour affichage seul (voir cadrage §5, "plusieurs candidats") — jamais
  // utilisés pour créer/modifier un tarif automatiquement, uniquement pour que l'utilisateur puisse
  // choisir explicitement parmi eux en prévisualisation.
  candidatsAlternatifs Json?

  // --- C. Décision humaine et tarif effectivement appliqué ---
  decision        DecisionLigneFournisseur @default(EN_ATTENTE)
  articleRetenuId Int?
  articleRetenu   Article?                 @relation("ArticleRetenuParLigne", fields: [articleRetenuId], references: [id])
  // FK unique : un tarif créé par une ligne ne peut être le tarif créé par aucune autre —
  // garantit la traçabilité un-pour-un Article → TarifArticle → LigneDocumentFournisseur.
  tarifCreeId     Int?                     @unique
  tarifCree       TarifArticle?            @relation(fields: [tarifCreeId], references: [id])

  @@index([documentId])
  @@index([articleProposeId])
  @@index([articleRetenuId])
}

model Stock {
  id Int @id @default(autoincrement())

  articleId Int
  depotId   Int

  quantite Float @default(0)

  article Article @relation(fields: [articleId], references: [id])
  depot   Depot   @relation(fields: [depotId], references: [id])

  @@unique([articleId, depotId])
}

model Unite {
  id          Int     @id @default(autoincrement())
  nom         String
  symbole     String
  type        String
  facteurBase Float
  actif       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarifs        TarifArticle[]
  lignesRecette RecetteLigne[]
}

model Conditionnement {
  id    Int     @id @default(autoincrement())
  nom   String
  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tarifs TarifArticle[]
}

model Allergene {
  id   Int    @id @default(autoincrement())
  nom  String
  code String @unique

  articles ArticleAllergene[]
}

model ArticleAllergene {
  articleId   Int
  allergeneId Int

  article   Article   @relation(fields: [articleId], references: [id])
  allergene Allergene @relation(fields: [allergeneId], references: [id])

  @@id([articleId, allergeneId])
}

model ValeurNutritionnelle {
  articleId Int @id

  energie           Float?
  proteines         Float?
  glucides          Float?
  sucres            Float?
  lipides           Float?
  acidesGrasSatures Float?
  fibres            Float?
  sel               Float?

  article Article @relation(fields: [articleId], references: [id])
}

model Document {
  id Int @id @default(autoincrement())

  articleId Int?

  nom    String
  type   String
  chemin String

  createdAt DateTime @default(now())

  article Article? @relation(fields: [articleId], references: [id])
}

model MouvementStock {
  id Int @id @default(autoincrement())

  articleId Int
  depotId   Int

  date DateTime @default(now())

  type String

  quantite Float

  motif String?

  article Article @relation(fields: [articleId], references: [id])
  depot   Depot   @relation(fields: [depotId], references: [id])

  // Ligne de commande fournisseur ayant créé précisément CE mouvement à la réception (voir
  // CommandeFournisseur) — nullable : un mouvement saisi à la main (formulaire "Mouvements de
  // stock") n'en a pas. FK unique, même principe que LigneDocumentFournisseur.tarifCreeId : une
  // ligne de commande ne peut créer qu'un seul mouvement.
  ligneCommande LigneCommandeFournisseur?

  @@index([articleId])
  @@index([depotId])
}

enum StatutCommandeFournisseur {
  EN_ATTENTE
  RECUE
  RECUE_PARTIELLEMENT
  ANNULEE
}

// Commande passée à UN fournisseur pour UN dépôt de destination — voir cadrage « boucle achats
// complète » : POST /achats/proposition ne fait que proposer, sans jamais rien écrire en base ;
// cette commande est ce qui est effectivement enregistré quand l'utilisateur valide la proposition
// (groupée par fournisseur, une commande réelle ne part jamais chez plusieurs fournisseurs à la
// fois).
model CommandeFournisseur {
  id Int @id @default(autoincrement())

  fournisseurId Int
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  depotId Int
  depot   Depot @relation(fields: [depotId], references: [id])

  statut StatutCommandeFournisseur @default(EN_ATTENTE)

  creeLe        DateTime  @default(now())
  dateReception DateTime?

  lignes LigneCommandeFournisseur[]

  @@index([fournisseurId])
  @@index([depotId])
}

model LigneCommandeFournisseur {
  id Int @id @default(autoincrement())

  commandeId Int
  commande   CommandeFournisseur @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  articleId Int
  article   Article @relation(fields: [articleId], references: [id])

  // Snapshot au moment de la commande (jamais recalculé après coup) : un futur renommage du
  // Conditionnement ne doit jamais réécrire silencieusement une commande déjà passée — même
  // principe que LigneDocumentFournisseur.designationLue.
  conditionnementLibelle String
  conditionnements       Int

  // Toujours en unité de base de l'article (même convention que Stock/MouvementStock, voir
  // versUniteBase) — seule échelle utilisée pour mettre à jour le stock à la réception.
  quantiteCommandeeBase Float
  // Renseignée uniquement à la réception (voir POST /commandes/:id/receptionner) ; peut différer
  // de quantiteCommandeeBase (réception partielle) — jamais réécrite après une première réception.
  quantiteRecueBase     Float?

  prixUnitaireBase Float

  mouvementStockId Int?            @unique
  mouvementStock   MouvementStock? @relation(fields: [mouvementStockId], references: [id])

  @@index([commandeId])
  @@index([articleId])
}

// Enregistrement d'une production réellement réalisée (un lot) — jamais une simple simulation :
// POST /productions crée cette ligne au moment où la recette est effectivement mise en œuvre, avec
// la quantité réellement visée. La planification (POST /production/planifier, voir
// planifierProduction.ts) reste, elle, un calcul à la volée jamais persisté — ce n'est qu'au moment
// d'enregistrer la production que ce lot existe. Sert d'ancrage daté aux contrôles HACCP réels
// (ControleHACCPProduction) : "quel lot, quel jour" est la question qu'un contrôle sanitaire pose
// réellement, jamais couverte par la seule procédure décrite sur la recette.
model Production {
  id Int @id @default(autoincrement())

  recetteId Int
  recette   Recette @relation(fields: [recetteId], references: [id])

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  depotId Int?
  depot   Depot? @relation(fields: [depotId], references: [id])

  dateProduction DateTime @default(now())

  // Toujours renseignés ensemble (jamais un seul des deux) : dérivés l'un de l'autre via
  // planifierProduction.ts au moment de l'enregistrement, quel que soit le mode choisi par
  // l'utilisateur (portions ou poids fini) — évite toute ambiguïté à l'affichage.
  portionsProduites Float
  poidsFiniProduitG Float

  // Qui a enregistré cette production — nullable et jamais supprimé en cascade : un compte
  // désactivé plus tard ne doit jamais effacer une preuve de traçabilité déjà enregistrée (même
  // principe que ControleHACCPProduction.creePar juste après).
  creeParId Int?
  creePar   Utilisateur? @relation(fields: [creeParId], references: [id])

  createdAt DateTime @default(now())

  controles ControleHACCPProduction[]

  @@index([recetteId])
  @@index([dateProduction])
}

// Contrôle HACCP réellement effectué, daté, pour un point critique d'une production précise —
// jamais modifiable après coup (aucune route PATCH/DELETE) : une correction se fait en ajoutant un
// nouveau contrôle, jamais en réécrivant l'historique, comme la réception d'une commande
// fournisseur n'est jamais réécrite après coup (voir LigneCommandeFournisseur.quantiteRecueBase).
model ControleHACCPProduction {
  id Int @id @default(autoincrement())

  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  recetteEtapeId Int
  recetteEtape   RecetteEtape @relation(fields: [recetteEtapeId], references: [id])

  dateHeure   DateTime
  valeur      String
  conforme    Boolean
  commentaire String?

  // Qui a réellement validé ce contrôle — c'est précisément la question qu'un contrôle sanitaire
  // pose ("qui a constaté cette valeur, pas seulement quand"), jamais couverte par un code d'accès
  // partagé. Nullable et jamais supprimé en cascade : voir Production.creeParId ci-dessus.
  creeParId Int?
  creePar   Utilisateur? @relation(fields: [creeParId], references: [id])

  createdAt DateTime @default(now())

  @@index([productionId])
  @@index([recetteEtapeId])
}

model Recette {
  id Int @id @default(autoincrement())

  nom          String
  instructions String?

  // Photo du plat fini, en data URL base64 (redimensionnée côté client avant envoi) : évite de
  // dépendre d'un stockage de fichiers externe ou d'un disque persistant en production.
  photo String?

  categorieId Int?
  categorie   CategorieRecette? @relation(fields: [categorieId], references: [id])

  sousCategorieId Int?
  sousCategorie   SousCategorieRecette? @relation(fields: [sousCategorieId], references: [id])

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  portions    Int    @default(1)
  prixVenteHT Float?

  // Poids d'une portion en grammes, accompagnement compris (ex. 350g dont 130g
  // d'accompagnement) : sert à convertir entre nombre de portions et poids total pour planifier
  // une production (voir RecetteLigne.gainCuissonPct pour le calcul du poids fini par ingrédient).
  poidsPortionG        Float?
  poidsAccompagnementG Float?

  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lignes       RecetteLigne[]
  etapes       RecetteEtape[]
  utilisations MenuLigne[]
  productions  Production[]

  lignesVenteProposees LigneVente[]              @relation("RecetteProposeeParLigneVente")
  lignesVenteRetenues  LigneVente[]              @relation("RecetteRetenueParLigneVente")
  aliasVentes          AliasProduitVenduImport[]

  @@index([nom])
}

// Une étape du procédé, dans l'ordre : la description couvre le geste/la technique à mettre en
// œuvre, et peut porter un point de contrôle HACCP (ex. décontamination des légumes avant
// cuisine, refroidissement à <10°C en moins de 2h, remise en température de +3°C à +63°C en
// moins d'1h) — mis en avant dans la fiche pour ne pas être noyé dans le texte de l'étape.
model RecetteEtape {
  id Int @id @default(autoincrement())

  recetteId Int
  recette   Recette @relation(fields: [recetteId], references: [id], onDelete: Cascade)

  ordre       Int
  description String

  pointCritiqueHACCP Boolean @default(false)
  controleHACCP      String?

  // Historique daté des contrôles réellement effectués sur ce point, production par production —
  // controleHACCP ci-dessus reste la description de la procédure à suivre (design de la recette),
  // jamais réécrite par un contrôle réel. Voir ControleHACCPProduction.
  controlesEffectues ControleHACCPProduction[]

  @@index([recetteId])
}

model RecetteLigne {
  id Int @id @default(autoincrement())

  recetteId Int
  recette   Recette @relation(fields: [recetteId], references: [id], onDelete: Cascade)

  articleId Int
  article   Article @relation(fields: [articleId], references: [id])

  quantite Float
  uniteId  Int
  unite    Unite @relation(fields: [uniteId], references: [id])

  // Pourcentage de gain de poids à la cuisson pour cet ingrédient dans cette recette (ex. eau ou
  // sauce absorbée par la viande), en plus du rendement (perte) déjà porté par l'article — utile
  // pour calculer le poids fini réel et donc les quantités à commander pour une production cible
  // (ex. produire 100kg de plat fini en sachant qu'on perd 20% de viande mais qu'on gagne 80%
  // d'eau par rapport à son poids). 0 par défaut : aucun gain, comportement inchangé.
  gainCuissonPct Float @default(0)

  ordre Int @default(0)

  @@index([recetteId])
  @@index([articleId])
}

// Un menu est une formule composée de plusieurs recettes (ex. Entrée + Plat + Dessert), vendue à
// un prix global ; son coût matière et son food cost se déduisent du coût de chaque recette qui
// le compose (voir MenuLigne), sur le même principe qu'une recette déduit le sien de ses articles.
model Menu {
  id Int @id @default(autoincrement())

  nom         String
  description String?

  categorieId Int?
  categorie   CategorieRecette? @relation(fields: [categorieId], references: [id])

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  prixVenteHT Float?

  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lignes MenuLigne[]

  @@index([nom])
}

model MenuLigne {
  id Int @id @default(autoincrement())

  menuId Int
  menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  recetteId Int
  recette   Recette @relation(fields: [recetteId], references: [id])

  quantite Float @default(1)
  ordre    Int   @default(0)

  @@index([menuId])
  @@index([recetteId])
}

// Mémorise, pour un texte de produit vendu donné (tel qu'exporté par une caisse enregistreuse), la
// recette déjà choisie la dernière fois — même principe qu'AliasIngredientImport, appliqué au
// rapprochement produit vendu -> recette plutôt qu'ingrédient -> article. Alimentée automatiquement
// à chaque import de ventes confirmé (voir POST /api/ventes/import), jamais éditée directement.
model AliasProduitVenduImport {
  id Int @id @default(autoincrement())

  texteNormalise String @unique

  recetteId Int
  recette   Recette @relation(fields: [recetteId], references: [id])

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@index([recetteId])
}

// Document original d'un import de ventes (export CSV/Excel d'une caisse enregistreuse/logiciel
// d'encaissement) — niveau A du pipeline, sur le même principe que DocumentFournisseur. Toujours
// créé directement à l'état final (pas d'étape de validation séparée, voir cadrage import Excel des
// listings fournisseurs, articles.ts) : l'utilisateur a déjà confirmé chaque ligne en
// prévisualisation avant que ce document n'existe.
model DocumentVentes {
  id Int @id @default(autoincrement())

  societeId Int
  societe   Societe @relation(fields: [societeId], references: [id])

  // Bornes déclarées par l'utilisateur à l'import (un export de caisse porte en général sur une
  // période précise) — jamais déduites des lignes, jamais obligatoires : une caisse qui n'exporte
  // pas de dates de vente par produit laisse simplement ces deux champs vides, sans bloquer
  // l'import ni la réconciliation (agrégée alors sur l'ensemble du document).
  periodeDebut DateTime?
  periodeFin   DateTime?

  nomFichierOriginal String?
  importeLe          DateTime @default(now())

  // Qui a réellement importé ce fichier — nullable et jamais supprimé en cascade : un compte
  // désactivé plus tard ne doit jamais effacer un historique d'import déjà enregistré (même
  // principe que Production.creeParId).
  creeParId Int?
  creePar   Utilisateur? @relation(fields: [creeParId], references: [id])

  lignes LigneVente[]

  @@index([societeId])
}

// Ce qu'un rapprochement produit vendu -> recette peut détecter, du plus fiable au moins fiable —
// pas de CODE_ARTICLE/REFERENCE_FOURNISSEUR ici (une Recette n'a ni code ni référence, seulement un
// nom, contrairement à un Article) : voir server/utils/rapprochementVentes.ts.
enum MotifCorrespondanceVente {
  ALIAS
  DESIGNATION_EXACTE
  DESIGNATION_APPROXIMATIVE
}

enum DecisionLigneVente {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

// Une ligne d'un export de caisse (un produit vendu, une quantité) — sépare les 3 mêmes niveaux que
// LigneDocumentFournisseur : A. ce que l'export dit, jamais réinterprété ; B. la proposition du
// moteur de rapprochement, jamais une décision ; C. la décision humaine + son effet. Un produit
// vendu qui ne correspond à aucune recette suivie ici (boisson, à la carte non fichée...) reste
// simplement REJETEE ou EN_ATTENTE : jamais de création automatique d'une recette à partir d'une
// ligne de vente, une recette ne pouvant pas être déduite d'un simple nom et d'un prix.
model LigneVente {
  id Int @id @default(autoincrement())

  documentVentesId Int
  documentVentes   DocumentVentes @relation(fields: [documentVentesId], references: [id], onDelete: Cascade)

  designationLue      String
  quantiteVendue      Float
  prixVenteUnitaireLu Float?

  recetteProposeeId    Int?
  recetteProposee      Recette?                  @relation("RecetteProposeeParLigneVente", fields: [recetteProposeeId], references: [id])
  confiance            Float?
  motifCorrespondance  MotifCorrespondanceVente?
  // Affichage seul (liste des autres candidats proches, triée par score) — jamais utilisés pour
  // écrire quoi que ce soit, voir LigneDocumentFournisseur.candidatsAlternatifs.
  candidatsAlternatifs Json?

  decision         DecisionLigneVente @default(EN_ATTENTE)
  recetteRetenueId Int?
  recetteRetenue   Recette?           @relation("RecetteRetenueParLigneVente", fields: [recetteRetenueId], references: [id])

  @@index([documentVentesId])
  @@index([recetteRetenueId])
}

enum OrigineErreur {
  SERVEUR
  CLIENT
}

// Journal d'erreurs auto-purgé (voir server/utils/journalErreurs.ts, plafond de 500 lignes) — pour
// qu'un PROPRIETAIRE puisse diagnostiquer un incident directement dans l'appli (écran Paramètres),
// sans devoir naviguer dans les logs Railway. Volontairement sans relation Prisma vers
// Societe/Utilisateur (simples Int nullable) : une ligne du journal doit survivre à la suppression
// du compte ou, en théorie, de la société concernée, jamais disparaître avec eux.
model JournalErreur {
  id Int @id @default(autoincrement())

  origine    OrigineErreur
  moment     DateTime      @default(now())
  methode    String?
  route      String?
  statutHttp Int?
  message    String
  pile       String?
  userAgent  String?

  societeId     Int?
  utilisateurId Int?

  @@index([moment])
  @@index([societeId])
}
