{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    // Uniquement pour server/utils/pdf/*.tsx (génération de PDF via @react-pdf/renderer,
    // React.createElement en JSX) — aucun autre fichier serveur n'utilise de JSX.
    "jsx": "react",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "server/**/*.ts",
    "server/**/*.tsx"
  ]
}
