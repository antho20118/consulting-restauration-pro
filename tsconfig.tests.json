{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "ES2023",
    // DOM (comme tsconfig.app.json) plutôt que le seul typage fetch/Response de @types/node : ce
    // dernier type Response.json() en Promise<unknown>, ce qui aurait forcé une assertion de type
    // sur chaque appel dans chaque test HTTP existant. Le fetch de Node est la même interface
    // WHATWG que celle de DOM — ce n'est pas un mensonge de typage, juste la définition la plus
    // permissive des deux pour un usage qui ne l'exploite jamais dans le navigateur.
    "lib": ["ES2023", "DOM"],
    // "vite/client" en plus de "node" (Phase 6) : tests/unit/analyserFactureLocal.test.ts importe
    // un utilitaire de src/features/fournisseurs/utils/ qui réutilise tel quel (jamais dupliqué)
    // analyserListingLocal.ts (Phase 4), lequel importe le type LigneListingExtraite depuis
    // listingFournisseurService.ts — qui importe à son tour src/config/api.ts, utilisant
    // import.meta.env. Sans ce type, tsc échoue sur ce fichier (ImportMeta.env inconnu), alors
    // qu'il compile déjà correctement sous tsconfig.app.json (qui déclare ce même type). N'affecte
    // que des déclarations de types ambiantes, aucun comportement à l'exécution.
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    // "bundler" plutôt que "NodeNext" (contrairement à tsconfig.node.json) : les tests importent à
    // la fois depuis server/ (imports relatifs avec extension .js, convention NodeNext) et depuis
    // src/ (imports relatifs sans extension, convention bundler de tsconfig.app.json) — voir
    // ligneImportee.test.ts et validationLignes.test.ts. "bundler" résout correctement les deux
    // sans qu'aucun fichier existant n'ait à changer sa propre convention d'import.
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests/**/*.ts"]
}
