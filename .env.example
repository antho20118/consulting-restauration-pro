# Connexion PostgreSQL. En local avec docker compose (voir docker-compose.yml),
# les identifiants ci-dessous fonctionnent tels quels.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consulting?schema=public"

# URL de l'API Express consommée par le frontend (server/server.ts)
VITE_API_URL="http://localhost:3000"

# Secret de signature des jetons de connexion (voir server/utils/auth.ts). À définir en
# production : une valeur par défaut non sécurisée est utilisée sinon.
JWT_SECRET=""

# Clé API Anthropic, utilisée par l'import de recette en texte libre (voir
# server/utils/importRecetteIA.ts). Sans elle, cette seule fonctionnalité est indisponible
# (503) ; le reste de l'appli fonctionne normalement.
ANTHROPIC_API_KEY=""

# Racine du volume persistant (Railway Volume en production) où sont stockés les fichiers
# fournisseurs (server/utils/storageDocumentsFournisseur.ts) et les sauvegardes JSON
# (prisma/sauvegarder.ts, sous un sous-dossier "sauvegardes"). Sans elle, les documents
# fournisseurs sont inaccessibles et prisma/restaurer.ts ne peut pas vérifier les fichiers
# physiques référencés par une sauvegarde (voir F08 — la vérification est alors simplement omise,
# jamais une erreur).
DOCUMENTS_STORAGE_PATH=""

# Base PostgreSQL CIBLE d'une restauration (voir docs/sauvegarde-restauration.md et
# prisma/restaurer.ts, F08 de l'audit forensique). Jamais DATABASE_URL : ce script refuse de
# s'y substituer, pour qu'une restauration ne puisse jamais écraser accidentellement la base de
# production couramment utilisée par l'application. La cible doit être une base PostgreSQL
# réellement VIERGE (aucune table) — la restauration est refusée sans exception sinon.
RESTORE_TARGET_DATABASE_URL=""
